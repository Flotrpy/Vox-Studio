{
  "name": "vox-studio",
  "version": "0.1.0",
  "description": "Vox Studio: a browser-based 3D game editor with the Vox Agent local helper.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "FLotrpy",
  "bin": {
    "vox-agent": "agent/agent.js"
  },
  "scripts": {
    "start": "node agent/agent.js",
    "test": "node --test",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
